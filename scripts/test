#!/bin/sh
# The check's own checks: a clean config passes, a broken one fails with the
# error quoted, a repo with no vim config skips without failing the build.
set -eu
root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
fail=0

mk() { mkdir -p "$tmp/$1/nvim"; printf '%s\n' "$2" > "$tmp/$1/nvim/init.lua"; }

mk good 'vim.opt.number = true'
( cd "$tmp/good" && nvim --clean -l "$root/check.lua" . ) || { echo 'FAIL: clean config should pass'; fail=1; }

mk bad "require('module_that_cannot_exist_anywhere')"
if ( cd "$tmp/bad" && nvim --clean -l "$root/check.lua" . ) > "$tmp/bad.out" 2>&1; then
  echo 'FAIL: an aborted init should fail the build'; fail=1
else
  grep -q 'FAILS TO BOOT' "$tmp/bad.out" || { echo 'FAIL: the failure should say so plainly'; fail=1; }
  grep -q 'module_that_cannot_exist_anywhere' "$tmp/bad.out" || { echo 'FAIL: the error should be quoted'; fail=1; }
fi

mkdir -p "$tmp/none"; echo hi > "$tmp/none/README.md"
( cd "$tmp/none" && nvim --clean -l "$root/check.lua" . ) | grep -q 'skipped' || { echo 'FAIL: no config should skip, not fail'; fail=1; }

# driver mode — the seam vim.pro's worker drives: a JSON result line, and the
# work tree kept for the caller (who captures the portrait there, then cleans)
out="$(cd "$tmp/good" && VIMPRO_CHECK_JSON=1 VIMPRO_CHECK_KEEP=1 nvim --clean -l "$root/check.lua" .)"
echo "$out" | grep -q 'VIMPRO_CHECK_RESULT {' || { echo 'FAIL: driver mode should print the JSON result'; fail=1; }
work="$(printf '%s' "$out" | sed -n 's/.*"work":"\([^"]*\)".*/\1/p')"
if [ -n "$work" ] && [ -d "$work" ]; then rm -rf "$work"; else echo 'FAIL: KEEP should keep the work tree'; fail=1; fi

# the classify seam: stderr in, the classification out, as JSON
printf 'E5113: broken thing\nDownloading something\n' \
  | nvim --clean -l "$root/check.lua" --classify | grep -q '"E5113: broken thing"' \
  || { echo 'FAIL: --classify should classify stdin'; fail=1; }

# real Vim, where this runner has one: a vimrc that is legal Vim and illegal
# nvim must boot clean under editor=vim and error under the default
if command -v vim >/dev/null 2>&1; then
  mkdir -p "$tmp/legacy"; printf 'set number\nset pastetoggle=<F2>\n' > "$tmp/legacy/.vimrc"
  ( cd "$tmp/legacy" && VIMPRO_CHECK_EDITOR=vim nvim --clean -l "$root/check.lua" . ) | grep -q 'boots clean.*on vim' \
    || { echo 'FAIL: legal Vim should boot clean in real Vim'; fail=1; }
  if ( cd "$tmp/legacy" && nvim --clean -l "$root/check.lua" . ) > "$tmp/legacy.out" 2>&1; then
    echo 'FAIL: pastetoggle should error under nvim'; fail=1
  else
    grep -q 'E519' "$tmp/legacy.out" || { echo 'FAIL: the nvim error should be quoted'; fail=1; }
  fi
  # an nvim-only config under editor=vim skips honestly instead of failing
  ( cd "$tmp/good" && VIMPRO_CHECK_EDITOR=vim nvim --clean -l "$root/check.lua" . ) | grep -q 'skipped' \
    || { echo 'FAIL: no vimrc + editor=vim should skip'; fail=1; }
fi

[ "$fail" = 0 ] && echo 'ok — pass, fail, and skip all behave'
exit "$fail"
